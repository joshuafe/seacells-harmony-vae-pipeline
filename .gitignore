# ==============================================================================
# SEACells + Harmony + VAE Pipeline - Git Ignore
# ==============================================================================
#
# This pipeline uses only specific scripts. All others are legacy/experimental.
#
# INCLUDED (tracked by git):
#   - scripts/seacells_batch_correction.py
#   - scripts/seacells_clustering_analysis.py
#   - scripts/metacell_vae.py
#   - scripts/create_marker_umaps.py
#   - run_pipeline.py, run_pipeline.sh, docker-run.sh
#   - environment.yml, Dockerfile, .dockerignore
#   - README.md, PIPELINE_README.md, QUICKSTART.md, GIT_SETUP.md
#   - SEACells/ package
#
# ==============================================================================

# Data Files (EXCLUDE FROM GIT)
# ------------------------------------------------------------------------------
*.fcs
*.FCS
data/
*.csv
*.npy
*.npz
*.h5ad

# Output Directories (EXCLUDE FROM GIT)
# ------------------------------------------------------------------------------
seacells_output/
metacell_vae_output/
plots/
archive/
workspaces/
notebooks/
config/
logs/
*.log

# Legacy/Unused Scripts (EXCLUDE FROM GIT)
# ------------------------------------------------------------------------------
# Only track the 4 scripts used in current pipeline
scripts/*
!scripts/seacells_batch_correction.py
!scripts/seacells_clustering_analysis.py
!scripts/metacell_vae.py
!scripts/create_marker_umaps.py

# Python Cache & Compiled Files
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

